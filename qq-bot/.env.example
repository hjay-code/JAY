# ── 必填：QQ 开放平台机器人凭证 ────────────────────────────────
# 在 https://q.qq.com/qqbot 的「开发设置」中获取。
# 注意：clientSecret 只能保存在服务端，禁止提交到 Git 或下发到客户端。
QQ_APP_ID=your-app-id
QQ_CLIENT_SECRET=your-client-secret

# ── 接入方式 ──────────────────────────────────────────────────
# websocket（默认，无需公网地址）或 webhook（需要公网 HTTPS）
QQ_CONNECTION_MODE=websocket

# 事件订阅位。GROUP_AND_C2C_EVENT = 1 << 25 = 33554432
# 同时订阅频道公域消息可改成 33554432 + 1073741824。
QQ_INTENTS=33554432

# 命令前缀
COMMAND_PREFIX=/

# ── Webhook 模式（QQ_CONNECTION_MODE=webhook 时生效）──────────
# 平台只允许 80 / 443 / 8080 / 8443 端口，且要求 HTTPS。
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/qqbot/webhook

# 签名密钥，默认使用 QQ_CLIENT_SECRET。
# WEBHOOK_SIGNATURE_SECRET=your-signing-secret

# 直接由 Node.js 提供 HTTPS 时填写证书路径；
# 若使用 Nginx / Caddy 等反向代理终止 TLS，则留空。
WEBHOOK_TLS_CERT=
WEBHOOK_TLS_KEY=

# ── AI Agent（可选）───────────────────────────────────────────
# 关闭时机器人只处理 /help、/ping 等指令，不会调用任何外部模型。
AI_ENABLED=false

# 任何 OpenAI 兼容的 /chat/completions 服务均可：
#   DeepSeek：https://api.deepseek.com/v1  + deepseek-chat
#   OpenAI：  https://api.openai.com/v1    + gpt-4.1-mini
#   通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
#   Ollama：  http://127.0.0.1:11434/v1    + qwen2.5（AI_API_KEY 随便填一个非空值）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=

# 非指令消息是否自动交给 AI 回复；关闭后仍可用 /ai 主动提问。
AI_AUTO_REPLY=true
# 留空使用内置中文系统提示词。
AI_SYSTEM_PROMPT=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=30000
# 每个会话最多保留多少条历史消息（user + assistant）。
AI_HISTORY_MESSAGES=20
# 对话记忆空闲过期时间（毫秒），默认 30 分钟。
AI_MEMORY_TTL_MS=1800000
# 单次回答最多执行几轮工具调用。
AI_MAX_TOOL_ROUNDS=4

# ── 可选运行参数 ──────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# OpenAPI 地址，一般不需要修改
QQ_API_BASE=https://api.bot.qq.com
HTTP_TIMEOUT_MS=15000
# 被动回复单条消息的最大长度（QQ 文本消息上限内）
MAX_REPLY_LENGTH=1200
# 事件去重缓存时间与容量
DEDUPE_TTL_MS=300000
DEDUPE_MAX_ENTRIES=5000
